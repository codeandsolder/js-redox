+/// Raw computed-property operand observed at an interpreter instruction.
+/// key_text displays the input operand; object keys may undergo user-defined
+/// ToPropertyKey later, so this is not always the final resolved property name.
+#[cfg(not(feature = "meter-only"))]
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PropertyWitness {
+    pub function_id: u32,
+    pub function_name: String,
+    pub source_start: usize,
+    pub source_end: usize,
+    pub bytecode_ip: usize,
+    pub operation: &'static str,
+    pub key_bits: u64,
+    pub key_text: String,
+    pub object_key: bool,
+}
+
+#[cfg(not(feature = "meter-only"))]
+#[derive(Debug)]
+pub struct PropertyWitnessReport {
+    pub events: Vec<PropertyWitness>,
+    pub truncated: bool,
+}
+
+#[cfg(not(feature = "meter-only"))]
+pub(crate) struct PropertyWitnessRecorder {
+    pub(crate) events: Vec<PropertyWitness>,
+    pub(crate) limit: usize,
+    pub(crate) truncated: bool,
+}
+
+#[cfg(not(feature = "meter-only"))]
+impl<'p> super::Vm<'p> {
+    pub(crate) fn observe_computed_property(&mut self, fid: u32, ip: usize, operation: &'static str, key: crate::value::Value) {
+        let Some(rec) = self.property_witnesses.as_ref() else { return; };
+        if rec.events.len() >= rec.limit {
+            self.property_witnesses.as_mut().unwrap().truncated = true;
+            return;
+        }
+        let f = self.func(fid as usize);
+        let (_, start, end) = f.source.parts();
+        let function_name = f.name.clone();
+        let object_key = self.is_object_value(key);
+        // Diagnostic display is non-coercing: unlike ToPropertyKey this
+        // never runs user-defined JS. Keep raw bits to distinguish identities.
+        let key_text = self.display(key);
+        let event = PropertyWitness {
+            function_id: fid,
+            function_name,
+            source_start: start,
+            source_end: end,
+            bytecode_ip: ip,
+            operation,
+            key_bits: key.bits(),
+            key_text,
+            object_key,
+        };
+        self.property_witnesses.as_mut().unwrap().events.push(event);
+    }
+}
