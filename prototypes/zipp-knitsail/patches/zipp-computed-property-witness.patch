+    /// Start bounded raw computed-property observations. Each event names its
+    /// bytecode site and source function range. JIT is disabled so native code
+    /// cannot silently escape observation. ToPropertyKey is never invoked here.
+    #[cfg(all(feature = "instrument", not(feature = "meter-only")))]
+    pub fn start_property_witnesses(&mut self, limit: usize) {
+        self.with_vm(|vm| {
+            vm.enter_trace_mode();
+            vm.property_witnesses = Some(crate::vm::instrument::PropertyWitnessRecorder {
+                events: Vec::new(), limit, truncated: false,
+            });
+        });
+    }
+
+    /// Take events with an explicit incompleteness signal.
+    #[cfg(all(feature = "instrument", not(feature = "meter-only")))]
+    pub fn take_property_witnesses(&mut self) -> Option<PropertyWitnessReport> {
+        self.with_vm(|vm| vm.property_witnesses.take().map(|r| PropertyWitnessReport {
+            events: r.events,
+            truncated: r.truncated,
+        })).flatten()
+    }
+
