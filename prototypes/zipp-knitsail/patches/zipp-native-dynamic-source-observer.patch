+#[cfg(test)]
+mod dynamic_source_outcome_tests {
+    use super::{
+        DynamicSourceKind as Kind, DynamicSourceOutcome as Outcome, Recorder,
+    };
+
+    #[test]
+    fn restarting_capture_does_not_complete_an_unrelated_reused_event_index() {
+        let mut recorder = Recorder::new();
+        recorder.start_dynamic_source_capture(5, 1000);
+        let first = recorder
+            .record_dynamic_source(Kind::DirectEval, b"throw 5", None)
+            .expect("first session ticket");
+        recorder.start_dynamic_source_capture(5, 1000);
+        let second = recorder
+            .record_dynamic_source(Kind::DirectEval, b"1 + 2", None)
+            .expect("second session ticket");
+        recorder.finish_dynamic_source(first, Outcome::Threw);
+        recorder.finish_dynamic_source(second, Outcome::Returned {
+            type_name: "number",
+        });
+        let capture = recorder.take_dynamic_source_capture().expect("second session");
+        assert_eq!(capture.events.len(), 1);
+        assert_eq!(capture.events[0].source_bytes, b"1 + 2");
+        assert_eq!(capture.events[0].outcome, Some(Outcome::Returned {
+            type_name: "number",
+        }));
+    }
+
+    #[test]
+    fn taking_capture_mid_eval_does_not_reassign_its_later_completion() {
+        let mut recorder = Recorder::new();
+        recorder.start_dynamic_source_capture(3, 100);
+        let ticket = recorder
+            .record_dynamic_source(Kind::IndirectEvalOrHost, b"42", None)
+            .expect("in-flight ticket");
+        let snapshot = recorder.take_dynamic_source_capture().expect("snapshot");
+        assert_eq!(snapshot.events[0].outcome, None);
+        recorder.finish_dynamic_source(ticket, Outcome::Returned {
+            type_name: "number",
+        });
+        recorder.start_dynamic_source_capture(3, 100);
+        let current = recorder
+            .record_dynamic_source(Kind::IndirectEvalOrHost, b"3", None)
+            .expect("current ticket");
+        recorder.finish_dynamic_source(ticket, Outcome::Threw);
+        recorder.finish_dynamic_source(current, Outcome::Returned {
+            type_name: "number",
+        });
+        let latest = recorder.take_dynamic_source_capture().expect("latest");
+        assert_eq!(latest.events[0].source_bytes, b"3");
+        assert_eq!(latest.events[0].outcome, Some(Outcome::Returned {
+            type_name: "number",
+        }));
+    }
+}
