+    /// Record the original bytes supplied to all runtime script-compiler
+    /// attempts, including direct/indirect eval and Function constructors.
+    ///
+    /// Requires `set_limits` (an attached recorder). Unlike `start_trace`,
+    /// this does not disable the native JIT or record instruction steps.
+    /// Caps only the OBSERVATION buffer: execution continues if it fills,
+    /// but `truncated` will be true and the events are not a complete record.
+    /// A Function constructor cache hit is still an attempt event.
+    #[cfg(feature = "instrument")]
+    pub fn start_dynamic_source_capture(&mut self, max_events: usize, max_bytes: usize) {
+        self.with_vm(|vm| {
+            if let Some(rec) = &mut vm.instr_rec {
+                rec.start_dynamic_source_capture(max_events, max_bytes);
+            }
+        });
+    }
+
+    /// Finish observing dynamic-source attempts; returns `None` if capture
+    /// was not enabled. Does not reset the instruction budget.
+    #[cfg(feature = "instrument")]
+    pub fn take_dynamic_source_capture(&mut self) -> Option<DynamicSourceCapture> {
+        self.with_vm(|vm| {
+            vm.instr_rec
+                .as_mut()
+                .and_then(|rec| rec.take_dynamic_source_capture())
+        })
+        .flatten()
+    }
+
