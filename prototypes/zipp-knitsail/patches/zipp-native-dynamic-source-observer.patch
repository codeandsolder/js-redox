+#[test]
+fn repeat_direct_eval_cache_and_function_ctor_cache_keep_separate_results() {
+    use zipp_vm::embed::DynamicSourceOutcome as O;
+    let mut state = compile_script(
+        r#"
+        function f(n) {
+            const x = n;
+            return eval('x+3');
+        }
+        if (f(1) !== 4 || f(2) !== 5 || f(9) !== 12) throw Error('direct cache');
+        for(let i=0;i<3;i++) {
+            const g = new Function("return 3");
+            if (g() !== 3) throw Error("function cache");
+        }
+        "#,
+    )
+    .expect("compile");
+    state.set_limits(1_000_000, None);
+    state.start_dynamic_source_capture(12, 4096);
+    state.run_init().expect("execute");
+    let capture = state.take_dynamic_source_capture().expect("capture");
+    assert_eq!(capture.events.len(), 6);
+    assert!(capture.events[..3]
+        .iter()
+        .all(|e| e.kind == DynamicSourceKind::DirectEval
+            && e.outcome
+                == Some(O::Returned {
+                    type_name: "number"
+                })));
+    assert!(capture.events[3..]
+        .iter()
+        .all(|e| e.kind == DynamicSourceKind::FunctionConstructor
+            && e.outcome
+                == Some(O::Returned {
+                    type_name: "function"
+                })));
+}
