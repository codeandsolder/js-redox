+/// Which entry into the common runtime script compiler was observed.
+///
+/// IndirectEvalOrHost includes embedder eval and ShadowRealm; ZIPP does not
+/// identify these more narrowly at the shared compiler boundary.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DynamicSourceKind {
+    DirectEval,
+    IndirectEvalOrHost,
+    FunctionConstructor,
+}
+
+/// Origin of the function that issued the dynamic-code request. The host may
+/// associate InitialProgram with the source bytes originally passed to
+/// compile_script; functions installed by eval, modules and later host
+/// scripts are *not* that source even if they have the same line and column.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DynamicCallerOrigin {
+    InitialProgram,
+    RuntimeInstalled,
+}
+
+/// Executing JavaScript source location associated with one dynamic-code
+/// attempt. This is the *callee callsite's reported position*, from the same
+/// bytecode metadata as Error.stack. It is NOT an AST node interval or a
+/// source-file/content hash; the host must match that separately.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct DynamicSourceCaller {
+    /// VM-local function index (not stable across independent executions).
+    pub function_id: u32,
+    /// Which compilation unit supplied this function (not its source hash).
+    pub origin: DynamicCallerOrigin,
+    /// Bytecode instruction offset in the caller, when known.
+    pub instruction_ip: u32,
+    /// 1-based line and UTF-16 column, including embedding origin offsets.
+    pub line: u32,
+    pub column: u32,
+}
+
+/// Outcome of the runtime compiler entry, including the evaluation that
+/// followed. This is local to the call (not a whole-script outcome).
+/// The return type is read from the VM's internal typeof operation without
+/// converting values to strings or running guest code.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum DynamicSourceOutcome {
+    Returned { type_name: &'static str },
+    Threw,
+}
+
+/// One attempt to compile or reuse a runtime source. The exact bytes may be
+/// WTF-8 (including lone surrogate encodings), so do not assume UTF-8.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct DynamicSourceEvent {
+    pub kind: DynamicSourceKind,
+    pub source_bytes: Vec<u8>,
+    /// None for host-originated eval, an unavailable call position, or an
+    /// internal/plumbing frame. Never infer an original AST location from it.
+    pub caller: Option<DynamicSourceCaller>,
+    /// None while the corresponding nested eval has not yet finished, or if
+    /// observation was taken mid-flight. Does not imply successful evaluation.
+    pub outcome: Option<DynamicSourceOutcome>,
+}
+
+/// An opt-in diagnostic capture, separate from the algebraic instruction
+/// trace. Events are ordered by compiler entry, not by JS call completion.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct DynamicSourceCapture {
+    pub events: Vec<DynamicSourceEvent>,
+    /// At least one event was omitted due to the configured byte/event cap.
+    /// A truncated capture is not complete execution evidence.
+    pub truncated: bool,
+}
+
+/// Session-qualified ticket: restarting capture while a native guest call is
+/// in flight must not finish an unrelated event at the same array index.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct DynamicSourceTicket {
+    session: u128,
+    index: usize,
+}
+
+struct DynamicSourceObserver {
+    session: u128,
+    captured: DynamicSourceCapture,
+    max_events: usize,
+    max_bytes: usize,
+    used_bytes: usize,
+}
+
+impl DynamicSourceObserver {
+    fn new(session: u128, max_events: usize, max_bytes: usize) -> Self {
+        Self {
+            session,
+            captured: DynamicSourceCapture {
+                events: Vec::new(),
+                truncated: false,
+            },
+            max_events,
+            max_bytes,
+            used_bytes: 0,
+        }
+    }
+
+    fn record(
+        &mut self,
+        kind: DynamicSourceKind,
+        bytes: &[u8],
+        caller: Option<DynamicSourceCaller>,
+    ) -> Option<usize> {
+        if self.captured.truncated {
+            return None;
+        }
+        if self.captured.events.len() >= self.max_events
+            || bytes.len() > self.max_bytes.saturating_sub(self.used_bytes)
+        {
+            self.captured.truncated = true;
+            return None;
+        }
+        let index = self.captured.events.len();
+        self.used_bytes += bytes.len();
+        self.captured.events.push(DynamicSourceEvent {
+            kind,
+            source_bytes: bytes.to_vec(),
+            caller,
+            outcome: None,
+        });
+        Some(index)
+    }
+
+    fn finish(&mut self, index: usize, outcome: DynamicSourceOutcome) {
+        if let Some(event) = self.captured.events.get_mut(index) {
+            // May be reentered by nested eval. Only its own frame may finish
+            // its assigned event, regardless of what happened in between.
+            if event.outcome.is_none() {
+                event.outcome = Some(outcome);
+            }
+        }
+    }
+}
+
