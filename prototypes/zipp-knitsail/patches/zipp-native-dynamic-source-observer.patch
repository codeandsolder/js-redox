+    pub(crate) fn start_dynamic_source_capture(&mut self, max_events: usize, max_bytes: usize) {
+        // If session identities are exhausted, refuse observation rather than
+        // reuse an identity belonging to an unfinished compilation.
+        let Some(session) = self.dynamic_source_session.checked_add(1) else {
+            self.dynamic_source_observer = None;
+            return;
+        };
+        self.dynamic_source_session = session;
+        self.dynamic_source_observer = Some(DynamicSourceObserver::new(session, max_events, max_bytes));
+    }
+
+    pub(crate) fn record_dynamic_source(
+        &mut self,
+        kind: DynamicSourceKind,
+        source: &[u8],
+        caller: Option<DynamicSourceCaller>,
+    ) -> Option<DynamicSourceTicket> {
+        let observer = self.dynamic_source_observer.as_mut()?;
+        observer.record(kind, source, caller).map(|index| DynamicSourceTicket {
+            session: observer.session,
+            index,
+        })
+    }
+
+    pub(crate) fn finish_dynamic_source(
+        &mut self,
+        ticket: DynamicSourceTicket,
+        outcome: DynamicSourceOutcome,
+    ) {
+        if let Some(observer) = &mut self.dynamic_source_observer {
+            if observer.session == ticket.session {
+                observer.finish(ticket.index, outcome);
+            }
+        }
+    }
+
+    pub(crate) fn take_dynamic_source_capture(&mut self) -> Option<DynamicSourceCapture> {
+        self.dynamic_source_observer
+            .take()
+            .map(|observer| observer.captured)
+    }
+
     /// Charge a dynamic compilation attempt before parsing or compiler
     /// allocation. Failed parses count too: otherwise a guest can repeatedly
     /// spend parser work without consuming the lifetime allowance.
@@ -1525,6 +1710,75 @@ impl super::Vm<'_> {
         }
     }
 
+    /// Observe exactly the bytes given to a runtime compilation attempt.
+    pub(crate) fn instrument_dynamic_source_attempt(
+        &mut self,
+        kind: DynamicSourceKind,
+        source: &[u8],
+    ) -> Option<DynamicSourceTicket> {
+        // The compiler path is extremely hot in code generators. No stack
+        // walk or position search unless a host explicitly enabled capture.
+        if !self
+            .instr_rec
+            .as_ref()
+            .is_some_and(|rec| rec.dynamic_source_observer.is_some())
+        {
+            return None;
+        }
+        // Only the DirectEval bytecode arm explicitly syncs the executing
+        // frame's IP to the exact operation. Ordinary native calls do not
+        // always update it, so deriving an indirect-eval/Function callsite
+        // from the last frame could silently attach a DIFFERENT call.
+        let caller = if kind == DynamicSourceKind::DirectEval {
+            self.frames.last().and_then(|frame| {
+                let ip = u32::try_from(frame.ip.checked_sub(1)?).ok()?;
+                let (line, column) = self.func(frame.func as usize).position_at(ip)?;
+                if line == 0
+                    || line == crate::bytecode::CallSite::HIDDEN
+                    || line & crate::bytecode::CallSite::PLUMBING != 0
+                {
+                    return None;
+                }
+                Some(DynamicSourceCaller {
+                    function_id: frame.func,
+                    origin: if (frame.func as usize) < self.main_func_count {
+                        DynamicCallerOrigin::InitialProgram
+                    } else {
+                        DynamicCallerOrigin::RuntimeInstalled
+                    },
+                    instruction_ip: ip,
+                    line,
+                    column,
+                })
+            })
+        } else {
+            None
+        };
+        rec_mut!(self).and_then(|rec| rec.record_dynamic_source(kind, source, caller))
+    }
+
+    /// Finish a specific source attempt by its stable event index. A nested
+    /// eval may have emitted more events before this one completes, so never
+    /// assume that the newest event belongs to the currently returning call.
+    pub(crate) fn instrument_dynamic_source_outcome(
+        &mut self,
+        ticket: Option<DynamicSourceTicket>,
+        result: &Result<crate::value::Value, super::Thrown>,
+    ) {
+        let Some(ticket) = ticket else {
+            return;
+        };
+        let outcome = match result {
+            Ok(value) => DynamicSourceOutcome::Returned {
+                type_name: self.type_of(*value),
+            },
+            Err(_) => DynamicSourceOutcome::Threw,
+        };
+        if let Some(rec) = rec_mut!(self) {
+            rec.finish_dynamic_source(ticket, outcome);
+        }
+    }
+
