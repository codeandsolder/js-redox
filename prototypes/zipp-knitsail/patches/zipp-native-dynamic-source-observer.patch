@@ -0,0 +1,272 @@
+#![cfg(feature = "instrument")]
+
+use zipp_vm::embed::{compile_script, DynamicCallerOrigin, DynamicSourceKind};
+
+#[test]
+fn captures_original_eval_sources_without_guest_rewriting() {
+    let mut state = compile_script(
+        r#"
+        let x = 5;
+        let a = eval("x + 7");
+        let b = (0, eval)("8 + 9");
+        let f = new Function("v", "return v + 4;");
+        if (a !== 12 || b !== 17 || f(6) !== 10) throw Error("bad JS result");
+        "#,
+    )
+    .expect("compile original script");
+    state.set_limits(1_000_000, None);
+    state.start_dynamic_source_capture(10, 4096);
+    state.run_init().expect("run original script");
+    let capture = state
+        .take_dynamic_source_capture()
+        .expect("enabled observer");
+    assert!(!capture.truncated);
+    assert_eq!(capture.events.len(), 3);
+    assert_eq!(capture.events[0].kind, DynamicSourceKind::DirectEval);
+    assert_eq!(capture.events[0].source_bytes, b"x + 7");
+    assert_eq!(
+        capture.events[1].kind,
+        DynamicSourceKind::IndirectEvalOrHost
+    );
+    assert_eq!(capture.events[1].source_bytes, b"8 + 9");
+    assert_eq!(
+        capture.events[2].kind,
+        DynamicSourceKind::FunctionConstructor
+    );
+    assert!(String::from_utf8_lossy(&capture.events[2].source_bytes).contains("return v + 4;"));
+    assert!(state.take_dynamic_source_capture().is_none());
+}
+
+#[test]
+fn capture_is_bounded_and_reports_incompleteness() {
+    let mut state = compile_script(
+        r#"
+        for (let i = 0; i < 6; i++) eval("globalThis.n = " + i);
+        if (globalThis.n !== 5) throw Error("bad result");
+        "#,
+    )
+    .expect("compile original script");
+    state.set_limits(1_000_000, None);
+    state.start_dynamic_source_capture(2, 1024);
+    state
+        .run_init()
+        .expect("complete guest script even when observer fills");
+    let capture = state.take_dynamic_source_capture().expect("capture");
+    assert_eq!(capture.events.len(), 2);
+    assert!(capture.truncated);
+}
+
+#[test]
+fn compile_attempt_not_successful_evaluation() {
+    let mut state = compile_script(
+        r#"
+        try { eval("var ???"); } catch (_) {}
+        eval(42);
+        try { eval("throw Error('whoops')"); } catch (_) {}
+        "#,
+    )
+    .expect("compile original script");
+    state.set_limits(1_000_000, None);
+    state.start_dynamic_source_capture(10, 4096);
+    state.run_init().expect("complete original script");
+    let capture = state.take_dynamic_source_capture().expect("capture");
+    assert!(!capture.truncated);
+    assert_eq!(capture.events.len(), 2, "non-string eval must not compile");
+    assert_eq!(capture.events[0].source_bytes, b"var ???");
+    assert_eq!(capture.events[1].source_bytes, b"throw Error('whoops')");
+}
+
+#[test]
+fn without_recorder_or_opt_in_no_sources_are_collected() {
+    let mut state = compile_script("eval('1+2');").expect("compile");
+    state.start_dynamic_source_capture(10, 100);
+    state.run_init().expect("run");
+    assert!(state.take_dynamic_source_capture().is_none());
+}
+
+#[test]
+fn nested_eval_preserves_compiler_entry_order() {
+    let mut state =
+        compile_script("var D = '\"4 + 3\"'; if (eval(eval(D)) !== 7) throw Error('wrong');")
+            .expect("compile");
+    state.set_limits(1_000_000, None);
+    state.start_dynamic_source_capture(10, 1024);
+    state.run_init().expect("execute");
+    let capture = state.take_dynamic_source_capture().expect("capture");
+    assert!(!capture.truncated);
+    assert_eq!(capture.events.len(), 2);
+    assert_eq!(capture.events[0].kind, DynamicSourceKind::DirectEval);
+    assert_eq!(capture.events[0].source_bytes, b"\"4 + 3\"");
+    assert_eq!(capture.events[1].kind, DynamicSourceKind::DirectEval);
+    assert_eq!(capture.events[1].source_bytes, b"4 + 3");
+}
+
+#[test]
+fn cached_function_construction_is_still_observed_as_an_attempt() {
+    let mut state = compile_script(
+        r#"
+        for (let i = 0; i < 2; i++) {
+            const f = new Function("x", "return x * 2;");
+            if (f(i) !== i * 2) throw Error("wrong");
+        }
+        "#,
+    )
+    .expect("compile");
+    state.set_limits(1_000_000, None);
+    state.start_dynamic_source_capture(10, 8192);
+    state.run_init().expect("execute");
+    let capture = state.take_dynamic_source_capture().expect("capture");
+    assert!(!capture.truncated);
+    assert_eq!(capture.events.len(), 2);
+    assert_eq!(
+        capture.events[0].kind,
+        DynamicSourceKind::FunctionConstructor
+    );
+    assert_eq!(
+        capture.events[0].source_bytes,
+        capture.events[1].source_bytes
+    );
+}
+
+#[test]
+fn source_byte_cap_never_interrupts_guest_execution() {
+    let mut state =
+        compile_script("if (eval('21 + 21') !== 42) throw Error('wrong');").expect("compile");
+    state.set_limits(1_000_000, None);
+    state.start_dynamic_source_capture(10, 3);
+    state
+        .run_init()
+        .expect("execute regardless of observer cap");
+    let capture = state.take_dynamic_source_capture().expect("capture");
+    assert!(capture.events.is_empty());
+    assert!(capture.truncated);
+}
+
+#[test]
+fn callsite_locations_use_original_js_utf16_columns() {
+    let mut state = compile_script(
+        "const emoji = '💡';\nconst x = eval('3 + 4');\nif (x !== 7) throw Error('bad');",
+    )
+    .expect("compile");
+    state.set_limits(1_000_000, None);
+    state.start_dynamic_source_capture(8, 1024);
+    state.run_init().expect("execute");
+    let capture = state.take_dynamic_source_capture().expect("capture");
+    assert_eq!(capture.events.len(), 1);
+    let caller = capture.events[0].caller.expect("source-correlated call");
+    assert_eq!((caller.line, caller.column), (2, 11));
+}
+
+#[test]
+fn all_repeated_direct_eval_attempts_are_observed_even_with_cache() {
+    let mut state = compile_script(
+        r#"
+        function f(n) {
+            let captured = n;
+            return eval("captured + 1");
+        }
+        if (f(1) !== 2 || f(5) !== 6 || f(8) !== 9) throw Error("bad");
+        "#,
+    )
+    .expect("compile");
+    state.set_limits(1_000_000, None);
+    state.start_dynamic_source_capture(10, 1024);
+    state.run_init().expect("execute");
+    let capture = state.take_dynamic_source_capture().expect("capture");
+    assert!(!capture.truncated);
+    assert_eq!(capture.events.len(), 3, "cache hits must remain observable");
+    for event in &capture.events {
+        assert_eq!(event.kind, DynamicSourceKind::DirectEval);
+        assert_eq!(event.source_bytes, b"captured + 1");
+        let caller = event.caller.expect("source location");
+        assert_eq!(caller.line, 4);
+        assert_eq!(caller.column, 20);
+    }
+}
+
+#[test]
+fn nested_eval_callsites_remain_distinct() {
+    let mut state = compile_script(
+        "const source = '\"2+3\"'; const result = eval(eval(source)); if (result!==5) throw Error('bad');",
+    ).expect("compile");
+    state.set_limits(1_000_000, None);
+    state.start_dynamic_source_capture(10, 1024);
+    state.run_init().expect("execute");
+    let capture = state.take_dynamic_source_capture().expect("capture");
+    assert_eq!(capture.events.len(), 2);
+    let inner = capture.events[0].caller.expect("inner source");
+    let outer = capture.events[1].caller.expect("outer source");
+    assert_eq!(inner.line, 1);
+    assert_eq!(outer.line, 1);
+    assert!(inner.column > outer.column);
+}
+
+#[test]
+fn distinct_indirect_eval_and_function_construction_source_locations() {
+    let mut state = compile_script(
+        "const a = (0, eval)('8+2');\nconst f = Function('return 13;');\nif(a !== 10 || f() !== 13) throw Error('bad');",
+    ).expect("compile");
+    state.set_limits(1_000_000, None);
+    state.start_dynamic_source_capture(10, 1024);
+    state.run_init().expect("execute");
+    let capture = state.take_dynamic_source_capture().expect("capture");
+    assert_eq!(capture.events.len(), 2);
+    assert_eq!(
+        capture.events[0].kind,
+        DynamicSourceKind::IndirectEvalOrHost
+    );
+    assert_eq!(
+        capture.events[1].kind,
+        DynamicSourceKind::FunctionConstructor
+    );
+    // Indirect and Function calls run through native code. Their suspended
+    // frames may point at unrelated JS instructions; no fake attribution.
+    assert!(capture.events[0].caller.is_none());
+    assert!(capture.events[1].caller.is_none());
+}
+
+#[test]
+fn embedding_host_eval_is_not_misattributed_to_previous_guest_frame() {
+    let mut state = compile_script("function f(){return 5;} f();").expect("compile");
+    state.set_limits(1_000_000, None);
+    state.start_dynamic_source_capture(10, 1024);
+    state.run_init().expect("initial script");
+    state.eval_in_context("1+2").expect("host-originated eval");
+    let capture = state.take_dynamic_source_capture().expect("capture");
+    assert_eq!(capture.events.len(), 1);
+    assert_eq!(
+        capture.events[0].kind,
+        DynamicSourceKind::IndirectEvalOrHost
+    );
+    assert!(capture.events[0].caller.is_none());
+}
+
+#[test]
+fn distinguishes_original_functions_from_runtime_compiled_functions() {
+    let mut state = compile_script(
+        r#"
+        function initial() { return eval("40+2"); }
+        if (initial() !== 42) throw Error("initial");
+        eval("function later() { return eval('5+8'); }");
+        if (later() !== 13) throw Error("runtime");
+        "#,
+    )
+    .expect("compile");
+    state.set_limits(1_000_000, None);
+    state.start_dynamic_source_capture(10, 4096);
+    state.run_init().expect("execute");
+    let capture = state.take_dynamic_source_capture().expect("capture");
+    assert_eq!(capture.events.len(), 3);
+    assert_eq!(
+        capture.events[0].caller.expect("original caller").origin,
+        DynamicCallerOrigin::InitialProgram
+    );
+    assert_eq!(
+        capture.events[1].caller.expect("original loader").origin,
+        DynamicCallerOrigin::InitialProgram
+    );
+    assert_eq!(
+        capture.events[2].caller.expect("generated caller").origin,
+        DynamicCallerOrigin::RuntimeInstalled
+    );
+}
