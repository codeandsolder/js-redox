diff --git a/crates/zipp-vm/tests/dynamic_source_capture.rs b/crates/zipp-vm/tests/dynamic_source_capture.rs
new file mode 100644
index 0000000..371fafc
--- /dev/null
+++ b/crates/zipp-vm/tests/dynamic_source_capture.rs
@@ -0,0 +1,129 @@
+#![cfg(feature = "instrument")]
+
+use zipp_vm::embed::{compile_script, DynamicSourceKind};
+
+#[test]
+fn captures_original_eval_sources_without_guest_rewriting() {
+    let mut state = compile_script(
+        r#"
+        let x = 5;
+        let a = eval("x + 7");
+        let b = (0, eval)("8 + 9");
+        let f = new Function("v", "return v + 4;");
+        if (a !== 12 || b !== 17 || f(6) !== 10) throw Error("bad JS result");
+        "#,
+    )
+    .expect("compile original script");
+    state.set_limits(1_000_000, None);
+    state.start_dynamic_source_capture(10, 4096);
+    state.run_init().expect("run original script");
+    let capture = state
+        .take_dynamic_source_capture()
+        .expect("enabled observer");
+    assert!(!capture.truncated);
+    assert_eq!(capture.events.len(), 3);
+    assert_eq!(capture.events[0].kind, DynamicSourceKind::DirectEval);
+    assert_eq!(capture.events[0].source_bytes, b"x + 7");
+    assert_eq!(capture.events[1].kind, DynamicSourceKind::IndirectEvalOrHost);
+    assert_eq!(capture.events[1].source_bytes, b"8 + 9");
+    assert_eq!(capture.events[2].kind, DynamicSourceKind::FunctionConstructor);
+    assert!(String::from_utf8_lossy(&capture.events[2].source_bytes)
+        .contains("return v + 4;"));
+    assert!(state.take_dynamic_source_capture().is_none());
+}
+
+#[test]
+fn capture_is_bounded_and_reports_incompleteness() {
+    let mut state = compile_script(
+        r#"
+        for (let i = 0; i < 6; i++) eval("globalThis.n = " + i);
+        if (globalThis.n !== 5) throw Error("bad result");
+        "#,
+    )
+    .expect("compile original script");
+    state.set_limits(1_000_000, None);
+    state.start_dynamic_source_capture(2, 1024);
+    state.run_init().expect("complete guest script even when observer fills");
+    let capture = state.take_dynamic_source_capture().expect("capture");
+    assert_eq!(capture.events.len(), 2);
+    assert!(capture.truncated);
+}
+
+#[test]
+fn compile_attempt_not_successful_evaluation() {
+    let mut state = compile_script(
+        r#"
+        try { eval("var ???"); } catch (_) {}
+        eval(42);
+        try { eval("throw Error('whoops')"); } catch (_) {}
+        "#,
+    )
+    .expect("compile original script");
+    state.set_limits(1_000_000, None);
+    state.start_dynamic_source_capture(10, 4096);
+    state.run_init().expect("complete original script");
+    let capture = state.take_dynamic_source_capture().expect("capture");
+    assert!(!capture.truncated);
+    assert_eq!(capture.events.len(), 2, "non-string eval must not compile");
+    assert_eq!(capture.events[0].source_bytes, b"var ???");
+    assert_eq!(capture.events[1].source_bytes, b"throw Error('whoops')");
+}
+
+#[test]
+fn without_recorder_or_opt_in_no_sources_are_collected() {
+    let mut state = compile_script("eval('1+2');").expect("compile");
+    state.start_dynamic_source_capture(10, 100);
+    state.run_init().expect("run");
+    assert!(state.take_dynamic_source_capture().is_none());
+}
+
+#[test]
+fn nested_eval_preserves_compiler_entry_order() {
+    let mut state = compile_script(
+        "var D = '\"4 + 3\"'; if (eval(eval(D)) !== 7) throw Error('wrong');",
+    )
+    .expect("compile");
+    state.set_limits(1_000_000, None);
+    state.start_dynamic_source_capture(10, 1024);
+    state.run_init().expect("execute");
+    let capture = state.take_dynamic_source_capture().expect("capture");
+    assert!(!capture.truncated);
+    assert_eq!(capture.events.len(), 2);
+    assert_eq!(capture.events[0].kind, DynamicSourceKind::DirectEval);
+    assert_eq!(capture.events[0].source_bytes, b"\"4 + 3\"");
+    assert_eq!(capture.events[1].kind, DynamicSourceKind::DirectEval);
+    assert_eq!(capture.events[1].source_bytes, b"4 + 3");
+}
+
+#[test]
+fn cached_function_construction_is_still_observed_as_an_attempt() {
+    let mut state = compile_script(
+        r#"
+        for (let i = 0; i < 2; i++) {
+            const f = new Function("x", "return x * 2;");
+            if (f(i) !== i * 2) throw Error("wrong");
+        }
+        "#,
+    )
+    .expect("compile");
+    state.set_limits(1_000_000, None);
+    state.start_dynamic_source_capture(10, 8192);
+    state.run_init().expect("execute");
+    let capture = state.take_dynamic_source_capture().expect("capture");
+    assert!(!capture.truncated);
+    assert_eq!(capture.events.len(), 2);
+    assert_eq!(capture.events[0].kind, DynamicSourceKind::FunctionConstructor);
+    assert_eq!(capture.events[0].source_bytes, capture.events[1].source_bytes);
+}
+
+#[test]
+fn source_byte_cap_never_interrupts_guest_execution() {
+    let mut state =
+        compile_script("if (eval('21 + 21') !== 42) throw Error('wrong');").expect("compile");
+    state.set_limits(1_000_000, None);
+    state.start_dynamic_source_capture(10, 3);
+    state.run_init().expect("execute regardless of observer cap");
+    let capture = state.take_dynamic_source_capture().expect("capture");
+    assert!(capture.events.is_empty());
+    assert!(capture.truncated);
+}
