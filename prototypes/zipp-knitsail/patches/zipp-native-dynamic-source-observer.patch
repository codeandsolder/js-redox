+        try { eval("var ???"); } catch (e) {}
+        try { eval("throw Error('inner')"); } catch (e) {}
+        if (results[0] !== 3 || results[1] !== 'hello' ||
+            results[2] !== undefined || results[3].a !== 1 ||
