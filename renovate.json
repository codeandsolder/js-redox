{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "separateMultipleMajor": true,
  "packageRules": [
    {
      "description": "Vendored upstream crate manifests are immutable backport baselines",
      "matchManagers": [
        "cargo"
      ],
      "matchFileNames": [
        "vendor/oxc_compat/**",
        "vendor/oxc_semantic/**"
      ],
      "enabled": false
    },
    {
      "description": "Coordinate Oxc and both Rolldown Git pins as one type universe, reviewing local Oxc backports before upgrades",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "/^oxc_/"
      ],
      "groupName": "Oxc and Rolldown",
      "automerge": false
    },
    {
      "description": "Coordinate Oxc and both Rolldown Git pins as one type universe, reviewing local Oxc backports before upgrades",
      "matchManagers": [
        "cargo"
      ],
      "matchDepNames": [
        "rolldown_redox",
        "string_wizard"
      ],
      "groupName": "Oxc and Rolldown",
      "automerge": false
    },
    {
      "description": "Group wasmparser and wasmprinter lockstep updates",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "wasmparser",
        "wasmprinter"
      ],
      "groupName": "Wasm parser and printer",
      "automerge": false
    },
    {
      "description": "Self-hosted runner labels are infrastructure, not hosted runner dependencies",
      "matchDatasources": [
        "github-runners"
      ],
      "enabled": false
    },
    {
      "description": "Review Rust compiler upgrades through Renovate's built-in toolchain manager",
      "matchManagers": [
        "rust-toolchain"
      ],
      "groupName": "Rust toolchain",
      "automerge": false
    },
    {
      "description": "Preserve pinned Rust 1.99/ZIPP Knitsail research harness dependency versions",
      "matchManagers": [
        "cargo"
      ],
      "matchFileNames": [
        "prototypes/zipp-knitsail/**"
      ],
      "enabled": false
    }
  ]
}
