{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "separateMultipleMajor": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Group Oxc crates so one type/version universe moves together",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["/^oxc_/"],
      "groupName": "Oxc crates",
      "automerge": false
    },
    {
      "description": "Group wasmparser and wasmprinter lockstep updates",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["wasmparser", "wasmprinter"],
      "groupName": "Wasm parser and printer",
      "automerge": false
    },
    {
      "description": "Self-hosted runner labels are infrastructure, not hosted runner dependencies",
      "matchDatasources": ["github-runners"],
      "enabled": false
    },
    {
      "description": "Automerge ordinary compatible updates after CI",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Potentially breaking pre-1.0 updates stay open for review",
      "matchCurrentVersion": "/^0\\./",
      "automerge": false
    },
    {
      "description": "Major updates stay open for review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Package replacements stay open for review",
      "matchUpdateTypes": ["replacement"],
      "minimumReleaseAge": null,
      "automerge": false
    },
    {
      "description": "Keep the Rust compiler baseline synchronized and review upgrades",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["Rust toolchain"],
      "groupName": "Rust toolchain",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|\\/)(Cargo\\.toml|rust-toolchain\\.toml)$/"],
      "matchStrings": ["(?:rust-version|channel)\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "Rust toolchain",
      "packageNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases"
    }
  ]
}
