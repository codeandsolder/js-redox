{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "separateMultipleMajor": true,
  "packageRules": [
    {
      "description": "Group Oxc crates so one type/version universe moves together",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "/^oxc_/"
      ],
      "groupName": "Oxc crates",
      "automerge": false
    },
    {
      "description": "Update both crates pinned to the same rolldown-redox fork commit together",
      "matchManagers": [
        "cargo"
      ],
      "matchDepNames": [
        "rolldown_redox",
        "string_wizard"
      ],
      "groupName": "Rolldown redox fork crates",
      "automerge": false
    },
    {
      "description": "Group wasmparser and wasmprinter lockstep updates",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "wasmparser",
        "wasmprinter"
      ],
      "groupName": "Wasm parser and printer",
      "automerge": false
    },
    {
      "description": "Self-hosted runner labels are infrastructure, not hosted runner dependencies",
      "matchDatasources": [
        "github-runners"
      ],
      "enabled": false
    },
    {
      "description": "Review Rust compiler upgrades through Renovate's built-in toolchain manager",
      "matchManagers": [
        "rust-toolchain"
      ],
      "groupName": "Rust toolchain",
      "automerge": false
    },
    {
      "description": "Preserve pinned Rust 1.99/ZIPP Knitsail research harness dependency versions",
      "matchManagers": [
        "cargo"
      ],
      "matchFileNames": [
        "prototypes/zipp-knitsail/**"
      ],
      "enabled": false
    }
  ]
}
