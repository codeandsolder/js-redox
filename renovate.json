{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "separateMultipleMajor": true,
  "packageRules": [
    {
      "description": "Coordinate all Oxc crates and both Rolldown Git pins as one type universe",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "/^oxc_/",
        "https://github.com/codeandsolder/oxc.git",
        "codeandsolder/oxc"
      ],
      "groupName": "Oxc and Rolldown"
    },
    {
      "description": "Coordinate all Oxc crates and both Rolldown Git pins as one type universe",
      "matchManagers": [
        "cargo"
      ],
      "matchDepNames": [
        "rolldown_redox",
        "string_wizard"
      ],
      "groupName": "Oxc and Rolldown"
    },
    {
      "description": "Group wasmparser and wasmprinter lockstep updates",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "wasmparser",
        "wasmprinter"
      ],
      "groupName": "Wasm parser and printer"
    },
    {
      "description": "Self-hosted runner labels are infrastructure, not hosted runner dependencies",
      "matchDatasources": [
        "github-runners"
      ],
      "enabled": false
    },
    {
      "description": "Preserve pinned Rust 1.99/ZIPP Knitsail research harness dependency versions",
      "matchManagers": [
        "cargo"
      ],
      "matchFileNames": [
        "prototypes/zipp-knitsail/**"
      ],
      "enabled": false
    }
  ]
}
