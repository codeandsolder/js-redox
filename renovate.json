{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "separateMultipleMajor": true,
  "packageRules": [
    {
      "description": "Group Oxc crates so one type/version universe moves together",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "/^oxc_/"
      ],
      "groupName": "Oxc crates",
      "automerge": false
    },
    {
      "description": "Group wasmparser and wasmprinter lockstep updates",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "wasmparser",
        "wasmprinter"
      ],
      "groupName": "Wasm parser and printer",
      "automerge": false
    },
    {
      "description": "Self-hosted runner labels are infrastructure, not hosted runner dependencies",
      "matchDatasources": [
        "github-runners"
      ],
      "enabled": false
    },
    {
      "description": "Keep the Rust compiler baseline synchronized and review upgrades",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "Rust toolchain"
      ],
      "groupName": "Rust toolchain",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|\\/)(Cargo\\.toml|rust-toolchain\\.toml)$/"
      ],
      "matchStrings": [
        "(?:rust-version|channel)\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "Rust toolchain",
      "packageNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases"
    }
  ]
}
